# MythologyMuse — environment template.
# Copy to `.env` and fill in your key. NEVER commit `.env`.
#
#   cp .env.example .env

# --- Meta Muse API (required for live runs; dry-run needs no key) ---
MUSE_API_KEY=your_muse_api_key_here
MUSE_BASE_URL=https://api.meta.ai/v1

# Text model for podcast narration / reflection / comic text stages.
MUSE_MODEL=muse-spark-1.3
MUSE_MODEL_TIER=contributor

# Thinking budget: off | low | medium | high | xhigh | dynamic
MUSE_THINKING_BUDGET=xhigh

# Per-call limits
MUSE_LLM_TIMEOUT=1800
MUSE_MAX_TOKENS=32768
